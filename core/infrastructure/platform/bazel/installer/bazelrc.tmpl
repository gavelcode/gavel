# --- Gavel (generated by `gavel init`) ---
{{- if .Go }}

# --- Go ---
build:gavel --aspects={{ .Label "go" "golangci-lint" }}
build:gavel --output_groups=gavel_submissions
build:gavel-go-archtest --aspects={{ .Label "go" "archtest" }}
build:gavel-go-archtest --output_groups=gavel_submissions
{{- end }}
{{- if .Java }}

# --- Java ---
build:gavel-java-pmd --aspects={{ .Label "java" "pmd" }}
build:gavel-java-pmd --output_groups=gavel_submissions
build:gavel-java-cpd --aspects={{ .Label "java" "cpd" }}
build:gavel-java-cpd --output_groups=gavel_submissions
build:gavel-java-spotbugs --aspects={{ .Label "java" "spotbugs" }}
build:gavel-java-spotbugs --output_groups=gavel_submissions
build:gavel-java-error-prone --aspects={{ .Label "java" "error-prone" }}
build:gavel-java-error-prone --output_groups=gavel_submissions
build:gavel-java-archtest --aspects={{ .Label "java" "archtest" }}
build:gavel-java-archtest --output_groups=gavel_submissions
{{- end }}
{{- if .Python }}

# --- Python ---
build:gavel-python-pycompile --aspects={{ .Label "python" "pycompile" }}
build:gavel-python-pycompile --output_groups=gavel_submissions
build:gavel-python-ruff --aspects={{ .Label "python" "ruff" }}
build:gavel-python-ruff --output_groups=gavel_submissions
build:gavel-python-bandit --aspects={{ .Label "python" "bandit" }}
build:gavel-python-bandit --output_groups=gavel_submissions
build:gavel-python-archtest --aspects={{ .Label "python" "archtest" }}
build:gavel-python-archtest --output_groups=gavel_submissions
{{- end }}
{{- if .TypeScript }}

# --- TypeScript ---
build:gavel-typescript --aspects={{ .Label "typescript" "eslint" }}
build:gavel-typescript --output_groups=gavel_submissions
build:gavel-typescript-archtest --aspects={{ .Label "typescript" "archtest" }}
build:gavel-typescript-archtest --output_groups=gavel_submissions
{{- end }}
{{- if .Rust }}

# --- Rust ---
build:gavel-rust-clippy --aspects={{ .Label "rust" "clippy" }}
build:gavel-rust-clippy --output_groups=gavel_submissions
{{- range .Flags "rust" "clippy" }}
build:gavel-rust-clippy {{ . }}
{{- end }}
build:gavel-rust-archtest --aspects={{ .Label "rust" "archtest" }}
build:gavel-rust-archtest --output_groups=gavel_submissions
{{- end }}
{{- if .Bridges }}

# --- Bridges (provided by the project, not guaranteed by gavel) ---
{{- range .Bridges }}
build:gavel-bridge-{{ .Name }} --aspects={{ .Aspect }}
build:gavel-bridge-{{ .Name }} --output_groups=gavel_submissions
{{- $name := .Name }}
{{- range .BuildFlags }}
build:gavel-bridge-{{ $name }} {{ . }}
{{- end }}
{{- end }}
{{- end }}
