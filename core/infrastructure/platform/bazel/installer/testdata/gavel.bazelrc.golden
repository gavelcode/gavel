# --- Gavel (generated by `gavel init`) ---

# --- Go ---
build:gavel --aspects=@gavel_tools_go//lint/aspects:defs.bzl%go_golangci_lint_submission_aspect
build:gavel --output_groups=gavel_submissions
build:gavel-go-archtest --aspects=@gavel_tools_go//lint/aspects:defs.bzl%go_archtest_submission_aspect
build:gavel-go-archtest --output_groups=gavel_submissions

# --- Java ---
build:gavel-java-pmd --aspects=@gavel_tools_java//lint/aspects:defs.bzl%java_pmd_submission_aspect
build:gavel-java-pmd --output_groups=gavel_submissions
build:gavel-java-cpd --aspects=@gavel_tools_java//lint/aspects:defs.bzl%java_cpd_submission_aspect
build:gavel-java-cpd --output_groups=gavel_submissions
build:gavel-java-spotbugs --aspects=@gavel_tools_java//lint/aspects:defs.bzl%java_spotbugs_submission_aspect
build:gavel-java-spotbugs --output_groups=gavel_submissions
build:gavel-java-error-prone --aspects=@gavel_tools_java//lint/aspects:defs.bzl%java_error_prone_submission_aspect
build:gavel-java-error-prone --output_groups=gavel_submissions
build:gavel-java-archtest --aspects=@gavel_tools_java//lint/aspects:defs.bzl%java_archtest_submission_aspect
build:gavel-java-archtest --output_groups=gavel_submissions

# --- Python ---
build:gavel-python-pycompile --aspects=@gavel_tools_python//lint/aspects:defs.bzl%python_pycompile_submission_aspect
build:gavel-python-pycompile --output_groups=gavel_submissions
build:gavel-python-ruff --aspects=@gavel_tools_python//lint/aspects:defs.bzl%python_ruff_submission_aspect
build:gavel-python-ruff --output_groups=gavel_submissions
build:gavel-python-bandit --aspects=@gavel_tools_python//lint/aspects:defs.bzl%python_bandit_submission_aspect
build:gavel-python-bandit --output_groups=gavel_submissions
build:gavel-python-archtest --aspects=@gavel_tools_python//lint/aspects:defs.bzl%python_archtest_submission_aspect
build:gavel-python-archtest --output_groups=gavel_submissions

# --- TypeScript ---
build:gavel-typescript --aspects=@gavel_tools_typescript//lint/aspects:defs.bzl%typescript_eslint_submission_aspect
build:gavel-typescript --output_groups=gavel_submissions
build:gavel-typescript-archtest --aspects=@gavel_tools_typescript//lint/aspects:defs.bzl%typescript_archtest_submission_aspect
build:gavel-typescript-archtest --output_groups=gavel_submissions

# --- Rust ---
build:gavel-rust-clippy --aspects=@gavel_tools_rust//lint/aspects:defs.bzl%rust_clippy_submission_aspect
build:gavel-rust-clippy --output_groups=gavel_submissions
build:gavel-rust-clippy --@rules_rust//rust/settings:capture_clippy_output=True
build:gavel-rust-clippy --@rules_rust//rust/settings:clippy_output_diagnostics=True
build:gavel-rust-archtest --aspects=@gavel_tools//lint/aspects:defs.bzl%rust_archtest_submission_aspect
build:gavel-rust-archtest --output_groups=gavel_submissions
